# Envol Africa Magazine - Environment Variables
# Copie ce fichier en .env.local et remplis les valeurs

# --- Moneroo Paiement (Afrique) ---
# Clé API secrète - tableau de bord > Développeurs > API Keys
MONEROO_SECRET_KEY=replace_with_moneroo_secret_key
MONEROO_API_KEY=replace_with_moneroo_api_key

# URL publique webhook - doit pointer vers moneroo/webhook.php en prod
# Ex: https://envolafricamag.com/moneroo/webhook.php
MONEROO_WEBHOOK_URL=https://envolafricamag.com/moneroo/webhook.php

# Secret de signature webhook - tableau de bord > Développeurs > Webhooks
MONEROO_WEBHOOK_SECRET=colle_ton_secret_de_signature_ici

# --- Base URL ---
NEXT_PUBLIC_BASE_URL=https://envolafricamag.com
# En dev: http://localhost:3000
# En Vercel: https://ton-projet.vercel.app

# --- JWT Secret ---
JWT_SECRET=change-me-super-secure-jwt-secret-32chars-minimum

# --- Supabase ---
SUPABASE_URL=https://rtfjwpytiuvoekomevpu.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://rtfjwpytiuvoekomevpu.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_a0s486xyTpd9OdTYjcMR9g_jN0upwoA
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_a0s486xyTpd9OdTYjcMR9g_jN0upwoA
SUPABASE_SERVICE_ROLE_KEY=sb_secret_TON_SECRET_ICI
SUPABASE_SECRET_KEY=sb_secret_TON_SECRET_ICI

# --- Postgres Direct (Prisma) ---
DATABASE_URL=postgresql://user:password@host:5432/database
DIRECT_URL=postgresql://user:password@host:5432/database
DATABASE_URL_POOLED=postgresql://user:password@host:6543/database?pgbouncer=true
